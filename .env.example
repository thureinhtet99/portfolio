# Copy to .env.local and fill in. Never commit .env.local.

# --- Auth (better-auth) ---
# Random secret used to sign sessions. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of the app (local: http://localhost:3000)
BETTER_AUTH_URL=

# --- URLs ---
# Public base URL used for sitemap/robots and internal fetches (local: http://localhost:3000)
NEXT_PUBLIC_BASE_URL=
# Public site URL used for metadataBase (local: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=

# --- Database ---
# Local SQLite file path (better-sqlite3). Used whenever VERCEL is not "1".
SQLITE_DB_PATH="./local.db"
# Production only (Turso). Leave unset locally; never set VERCEL=1 locally.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Contact form (nodemailer / Gmail) ---
# Gmail address that sends and receives contact-form mail
GMAIL_EMAIL=
# Gmail app password (Google Account -> Security -> App passwords; requires 2FA)
GMAIL_APP_PASSWORD=

# --- Cloudinary (admin uploads) ---
# Cloud name from the Cloudinary dashboard
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Used by app/api/upload (note: NEXT_PUBLIC_ prefix on a secret, see docs/PROJECT_MAP.md §10)
NEXT_PUBLIC_CLOUDINARY_API_KEY=
NEXT_PUBLIC_CLOUDINARY_API_SECRET=
# Used by app/api/projects and app/api/settings for asset cleanup (same values as above)
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Giscus comments (/leave-a-note) ---
# Values from https://giscus.app (repo as "owner/name")
NEXT_PUBLIC_GISCUS_REPO=
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=
NEXT_PUBLIC_GISCUS_CATEGORY_ID=

# --- GitHub (optional) ---
# Personal access token, no scopes needed; raises GitHub/Katib rate limits
GITHUB_TOKEN=
# Override the contributions API (default: https://github-contributions-api.jogruber.de)
GITHUB_CONTRIBUTIONS_API_URL=
